{
  "name": "mcpgate",
  "version": "0.1.0",
  "private": true,
  "description": "A prototype HTTP MCP gateway with bearer authentication, rate limiting, and audit logging.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "deploy:cloudflare": "wrangler deploy",
    "postinstall": "sigmap",
    "map:refresh": "sigmap",
    "map:report": "sigmap --report --json",
    "map:watch": "sigmap daemon start",
    "map:setup": "sigmap --setup"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.30"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260717.1",
    "@types/node": "^22.0.0",
    "sigmap": "^8.18.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
